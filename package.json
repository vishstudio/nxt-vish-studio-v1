{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "dev:next": "next dev",
    "build": "(tinacms build && rm -f public/admin/.gitignore) || echo 'Tina build skipped (missing token), using committed generated files' && next build",
    "start": "next start",
    "clean": "rm -rf .next out",
    "lint": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "npm run build && touch out/.nojekyll && cp public/CNAME out/CNAME 2>/dev/null; echo 'Build ready in out/ — push to gh-pages branch to deploy'"
  },
  "homepage": "https://vish.studio",
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.5.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^3.5.0",
    "tinacms": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tinacms/cli": "^2.1.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "fs-extra": "^11.4.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "slate": "^0.126.0",
    "slate-dom": "^0.126.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.1.3"
  }
}
