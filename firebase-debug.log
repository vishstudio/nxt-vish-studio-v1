[debug] [2026-07-29T02:55:03.784Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/studio-portal-b03fe/rulesets {"name":"projects/studio-portal-b03fe/rulesets/59f672d0-68f9-4850-88d3-fdf225667bf1","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /briefs/{briefId} {\n      allow create: if\n        request.resource.data.keys().hasOnly([\n          'service', 'package', 'answers', 'questionnaire', 'contact', 'status',\n          'source', 'createdAt', 'submittedAt'\n        ]) &&\n        request.resource.data.status == 'new' &&\n        request.resource.data.source == 'vish.studio/start-project' &&\n        request.resource.data.createdAt == request.time &&\n        request.resource.data.contact.name is string &&\n        request.resource.data.contact.name.size() >= 1 &&\n        request.resource.data.contact.email is string &&\n        request.resource.data.contact.email.size() >= 5 &&\n        request.resource.data.contact.phone is string &&\n        request.resource.data.contact.phone.size() >= 5;\n\n      allow read, update, delete: if false;\n    }\n\n    match /bookings/{bookingId} {\n      allow create: if\n        request.resource.data.keys().hasOnly([\n          'name', 'email', 'company', 'selectedDate', 'selectedTime',\n          'startAt', 'endAt', 'durationMinutes', 'timezone', 'status',\n          'source', 'hostEmail', 'publicEmail', 'meetLink',\n          'calendarEventId', 'notes', 'createdAt', 'updatedAt',\n          'submittedAt'\n        ]) &&\n        request.resource.data.name is string &&\n        request.resource.data.name.size() >= 1 &&\n        request.resource.data.email is string &&\n        request.resource.data.email.size() >= 5 &&\n        request.resource.data.company is string &&\n        request.resource.data.selectedDate is string &&\n        request.resource.data.selectedTime in [\n          '09:30', '10:00', '10:30', '13:00', '13:30',\n          '14:00', '14:30', '15:00', '15:30'\n        ] &&\n        request.resource.data.startAt is timestamp &&\n        request.resource.data.endAt is timestamp &&\n        request.resource.data.durationMinutes == 30 &&\n        request.resource.data.timezone == 'Indian/Mauritius' &&\n        request.resource.data.status == 'pending' &&\n        request.resource.data.source == 'vish.studio/book-call' &&\n        request.resource.data.hostEmail == 'vishstudio.ltd@gmail.com' &&\n        request.resource.data.publicEmail == 'hello@vish.studio' &&\n        request.resource.data.meetLink == '' &&\n        request.resource.data.calendarEventId == '' &&\n        request.resource.data.notes == '' &&\n        request.resource.data.createdAt == request.time &&\n        request.resource.data.updatedAt == request.time &&\n        request.resource.data.submittedAt is string;\n\n      allow read, update, delete: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-29T02:55:03.821151Z","metadata":{"services":["cloud.firestore"]}}
